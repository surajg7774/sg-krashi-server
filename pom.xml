<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.sgkrashi</groupId>
    <artifactId>sg-krashi-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>sg-krashi-server</name>
    <description>SG Krashi agriculture platform - modular monolith backend</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.6</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
        <razorpay.version>1.4.7</razorpay.version>
        <aws-sdk.version>2.29.52</aws-sdk.version>
        <openpdf.version>2.0.3</openpdf.version>
        <cloudinary.version>2.0.0</cloudinary.version>
        <firebase-admin.version>9.11.0</firebase-admin.version>
        <google-api-client.version>2.9.1</google-api-client.version>

        <!-- Security patch overrides of what Spring Boot 3.5.16 manages (3.5.16 is the newest 3.5.x, so the
             fixes are not in its BOM yet). Remove each line once a Boot release includes it. -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <tomcat.version>10.1.59</tomcat.version>
        <netty.version>4.1.137.Final</netty.version>
        <httpcore5.version>5.4.3</httpcore5.version>
        <!-- httpclient5 5.6.x is the line built against httpcore5 5.4.x; 5.5.x is built against 5.3.x. -->
        <httpclient5.version>5.6.4</httpclient5.version>
        <!-- razorpay-java 1.4.7 pulls in okhttp 3.10.0 (certificate/hostname verification advisory, fixed in 4.9.2). -->
        <okhttp.version>4.12.0</okhttp.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>logging-interceptor</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>com.razorpay</groupId>
            <artifactId>razorpay-java</artifactId>
            <version>${razorpay.version}</version>
        </dependency>

        <!-- S3-compatible object storage for S3StorageProvider — the plain
             client, not the Spring Cloud AWS starter, since only put/delete +
             a configurable endpoint override are needed. Works against real
             AWS S3 or any genuinely S3-protocol-compatible provider
             (DigitalOcean Spaces, Backblaze B2, self-hosted MinIO, ...) via
             S3_ENDPOINT. Cloudinary is NOT one of these — it has no
             S3-compatible endpoint at all, despite an earlier version of this
             comment claiming otherwise; see CloudinaryStorageProvider for its
             actual (REST upload API) integration. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws-sdk.version}</version>
        </dependency>

        <!-- Cloudinary object storage for CloudinaryStorageProvider — the
             real Cloudinary Java SDK (cloud_name/api_key/api_secret + its own
             REST upload API), not the S3 client above, since Cloudinary is
             not S3-protocol-compatible. cloudinary-http5 is the current
             (Apache HttpClient 5-based) artifact; cloudinary-taglib and
             dotenv-java from Cloudinary's own quickstart aren't needed here
             — no JSP tags, and Spring's own @Value/env-var binding already
             covers what dotenv-java is for. -->
        <dependency>
            <groupId>com.cloudinary</groupId>
            <artifactId>cloudinary-http5</artifactId>
            <version>${cloudinary.version}</version>
        </dependency>

        <!-- FcmNotificationSender's push channel — the real Firebase Admin
             SDK, used only to send already-composed messages to already-known
             device tokens (see FcmNotificationSender's Javadoc). Inert until
             FCM_ENABLED=true and FIREBASE_SERVICE_ACCOUNT_JSON are both set;
             just being on the classpath costs nothing at boot. -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>${firebase-admin.version}</version>
        </dependency>

        <!-- GoogleAuthServiceImpl's ID-token verification (GoogleIdTokenVerifier)
             for "Sign in with Google" — a separate Google SDK family from
             firebase-admin above (this one is generic OAuth2/OIDC token
             verification, not Firebase-specific), but the same
             well-established Google Java client library approach. -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>${google-api-client.version}</version>
        </dependency>

        <!-- AI Crop Doctor (Task: com.sgkrashi.cropdoctor) — WebClient is the HTTP
             boundary to the Python AI service. Only spring-webflux + a client-side
             HTTP connector are added, not the full spring-boot-starter-webflux:
             this app stays a servlet (spring-boot-starter-web) application, it just
             also needs WebClient as an outbound HTTP client, the same
             minimal-dependency reasoning as the plain S3 client above. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
        </dependency>

        <!-- AI Crop Doctor PDF scan reports (Section 5.6) — no existing PDF
             generation anywhere in this project. OpenPDF (Apache-2.0/LGPL fork of
             iText 4) chosen over iText itself, which is AGPL. -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
